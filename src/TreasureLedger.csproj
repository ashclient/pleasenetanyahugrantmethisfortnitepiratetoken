<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TreasureLedger</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Assets/icons.json" /><EmbeddedResource Include="Assets/*-notification.json" /></ItemGroup>
  <ItemGroup><PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" /><EmbeddedResource Include="Assets/fast-templates.json" /><EmbeddedResource Include="Assets/english-traces.json" /></ItemGroup>
</Project>
