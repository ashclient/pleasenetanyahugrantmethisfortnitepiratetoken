<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TreasureLedger</AssemblyName>
    <Version>0.5.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Assets/icons.json" /><EmbeddedResource Include="Assets/*-notification.json" /></ItemGroup>
  <ItemGroup><PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" /><EmbeddedResource Include="Assets/fast-templates.json" /><EmbeddedResource Include="Assets/english-traces.json" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="../THIRD_PARTY_GABRIEL_GOMEZ.txt" LogicalName="ThirdParty.GabrielGomez.txt" /><EmbeddedResource Include="../THIRD_PARTY_OPENCVSHARP.txt" LogicalName="ThirdParty.OpenCvSharp.txt" /></ItemGroup>
<ItemGroup Condition="Exists('../worker-dist/TreasureLedger.ReplayWorker.exe')">
  <EmbeddedResource Include="../worker-dist/TreasureLedger.ReplayWorker.exe" LogicalName="ReplayWorker.Exe" />
  <EmbeddedResource Include="../worker-dist/worker.sha256" LogicalName="ReplayWorker.Sha256" />
  <EmbeddedResource Include="../worker-dist/ReplayWorkerSource.zip" LogicalName="ReplayWorker.Source" />
</ItemGroup>
</Project>
